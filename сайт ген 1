/* Текст трактовки -> безопасный HTML (абзацы, списки, разделители). */
function mxFmt(text){
  const els = []; let para = [], list = [];
  const flushP = () => { if (para.length){ els.push({t:'p', lines:para}); para = []; } };
  const flushL = () => { if (list.length){ els.push({t:'ul', items:list}); list = []; } };
  String(text).replace(/\r/g,'').split('\n').forEach(raw => {
    const l = raw.trim();
    if (!l){ flushP(); flushL(); return; }
    if (/^-{3,}$/.test(l)){ flushP(); flushL(); els.push({t:'hr'}); return; }
    const m = l.match(/^[-•]\s+(.*)$/);
    if (m){ flushP(); list.push(m[1]); return; }
    flushL(); para.push(l);
  });
  flushP(); flushL();
  return els.map((e, i) => {
    if (e.t === 'hr') return '<hr>';
    if (e.t === 'ul') return '<ul>' + e.items.map(x => '<li>' + esc(x) + '</li>').join('') + '</ul>';
    if (i === 0 && e.lines.length === 1 && e.lines[0].length <= 56 && !/[.!?…:]$/.test(e.lines[0]))
      return '<p class="tx-title">' + esc(e.lines[0]) + '</p>';
    return '<p>' + e.lines.map(esc).join('<br>') + '</p>';
  }).join('');
}

