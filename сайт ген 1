  `;

  MX.linkError = '';
  const otherBtn = document.getElementById('mxOther');
  if (otherBtn) otherBtn.addEventListener('click', () => {
    mxResetPaid(); MX.res = null; MX.active = null; MX.date = ''; MX.dateRaw = null; MX.source = ''; MX.touched = true;
    try { location.hash = '#matrix'; } catch (e) {}
    render();
  });
  const dateEl = document.getElementById('mxDate');
  if (!dateEl) return mxWireResult();
  const mxSync = () => { MX.dateRaw = dateEl.value; MX.date = dateTextToISO(dateEl.value); MX.touched = true; MX.source = ''; };
  bindDateMask(dateEl, mxSync);
  dateEl.addEventListener('keydown', e => { if (e.key === 'Enter' && !e.isComposing){ e.preventDefault(); mxSync(); mxCalculate(); } });
  document.getElementById('mxGo').addEventListener('click', () => { mxSync(); mxCalculate(); });
  if (!hasRes) return;
  mxWireResult();
}

/* Обработчики результата: схема, списки, возраст, панель трактовки. */
function mxWireResult(){
  if (!MX.res) return;
  const chart = document.getElementById('mxChart');
  chart.addEventListener('click', e => { const g = e.target.closest('.mx-n'); if (g) mxOpen(g.dataset.pos); });
  chart.addEventListener('keydown', e => {
    if (e.key !== 'Enter' && e.key !== ' ') return;
    const g = e.target.closest && e.target.closest('.mx-n'); if (!g) return;
    e.preventDefault(); mxOpen(g.dataset.pos);
  });
  document.querySelectorAll('.chip-pos').forEach(b => b.addEventListener('click', () => mxOpen(b.dataset.pos)));
  const ageEl = document.getElementById('mxAge');
  const goAge = () => {
    const raw = ageEl.value.trim(), ok = /^\d{1,3}$/.test(raw) && +raw <= 120;
    document.getElementById('mxAgeErr').classList.toggle('show', !ok);
    ageEl.classList.toggle('invalid', !ok);
    if (!ok){ ageEl.focus(); return; }
    MX.ageVal = raw;
    const age = +raw, key = MatrixCore.getAgeNodeKey(age);
    MX.forecastAge = age; MX.forecastKeyFor = key;
    mxOpen(key, {forecast: true});
  };
  document.getElementById('mxAgeGo').addEventListener('click', goAge);
  ageEl.addEventListener('keydown', e => { if (e.key === 'Enter' && !e.isComposing){ e.preventDefault(); goAge(); } });
  document.getElementById('mxReading').addEventListener('click', e => {
    if (e.target.closest('[data-act="chart"]')){
      const c = document.getElementById('mxChartCard'); if (c) c.scrollIntoView({behavior: reduceMotion ? 'auto' : 'smooth', block: 'start'});
    }
    if (e.target.closest('[data-act="editdate"]')){
      const f = document.getElementById('mxForm'); if (f) f.scrollIntoView({behavior: reduceMotion ? 'auto' : 'smooth', block: 'start'});
      const i = document.getElementById('mxDate'); if (i) i.focus({preventScroll: true});
    }
    if (!SERVER_MODE && e.target.closest('#mxPayBtn')) mxDemoUnlock();
    if (e.target.closest('#mxOpenBtn')) mxOpenFree();
    if (e.target.closest('#mxDevPay')) mxDevPay();
  });
  mxLayoutChart();
  mxRenderReading();
}

if (window.matchMedia){
  const mq = matchMedia('(max-width: 640px)');
  const onChange = () => mxLayoutChart();
  if (mq.addEventListener) mq.addEventListener('change', onChange); else if (mq.addListener) mq.addListener(onChange);
}


render();
