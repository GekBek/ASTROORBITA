function collectStep(prefix){
  const get = id => document.getElementById(id).value.trim();
  const skip = document.getElementById(`${prefix}_skip`).checked;
  state.formData[prefix] = {
    name: get(`${prefix}_name`),
    date: dateTextToISO(get(`${prefix}_date`)),
    dateRaw: get(`${prefix}_date`),
    time: skip ? '' : get(`${prefix}_time`),
    skip,
    city: get(`${prefix}_city`),
  };
}

function validateStep(prefix){
  const p = state.formData[prefix];
  const dateInput = document.getElementById(`${prefix}_date`);
  const errEl = document.getElementById(`${prefix}_date_err`);
  const today = new Date();
  const bad = !isRealPastDate(p.date);
  dateInput.classList.toggle('invalid', bad);
  dateInput.setAttribute('aria-invalid', bad ? 'true' : 'false');
  errEl.classList.toggle('show', bad);
  const sum = document.getElementById('formErr');
  if (sum){
    sum.textContent = bad ? 'Чтобы продолжить, укажите корректную дату рождения.' : '';
    sum.classList.toggle('show', bad);
  }
  if (bad) dateInput.focus();
  return !bad;
}

function goNext(){
  collectStep('a');
  if (!validateStep('a')) return;
  state.step = 2;
  trackEvent('birth_date_entered', 'page');
  render();
}
function goBack(){
  collectStep('b');
  state.step = 1;
  render();
}

function onSubmit(){
  collectStep('b');
  if (!validateStep('b')) return;

  const personA = {
    name: state.formData.a.name || 'Партнёр A', date: state.formData.a.date,
    time: state.formData.a.time, city: state.formData.a.city,
  };
  const personB = {
    name: state.formData.b.name || 'Партнёр B', date: state.formData.b.date,
    time: state.formData.b.time, city: state.formData.b.city,
  };

  state.screen = 'calculating';
  render();

  if (SERVER_MODE){
    // Рабочий режим: считает сервер (Engine v2.1). Экран расчёта показывается те же
    // 1,9 с, что и раньше, но запрос идёт параллельно, а не после паузы.
    trackEvent('partner_date_entered', 'page');
    state.access = null; state.isPaid = false; state.awaitingPayment = false;
    const request = apiFetch('/api/compatibility', { method: 'POST', body: JSON.stringify({ personA: apiPerson(personA), personB: apiPerson(personB) }) }).catch(() => null);
    Promise.all([request, sleep(1900)]).then(([resp]) => {
      if (!resp || !resp.ok || !resp.data || !resp.data.access_token){
        state.calcError = resp && resp.status === 422
          ? 'Сервер не принял данные. Проверьте даты и время рождения.'
          : 'Не удалось выполнить расчёт. Проверьте соединение и попробуйте ещё раз.';
        state.screen = 'landing'; state.step = 2; render();
        return;
      }
      applyServerResponse(resp.data, personA.name, personB.name);
      state.screen = 'report';
      render();
    });
    return;
  }

  // Calculation is cheap (a handful of arithmetic ops) — the delay below is
  // purely a UX pacing device, not a real processing cost. (Unchanged.)
  setTimeout(() => {
    const calc = Backend.create(personA, personB);
    state.calc = calc;
    state.report = buildReport(calc);
    state.showFull = false;
    state.screen = 'report';
    render();
  }, 1900);
}

function applyServerResponse(data, nameA, nameB){
  setPayments(data.payments_enabled);
  state.calc = {
    person_a: { name: nameA }, person_b: { name: nameB },
    precision: data.precision, scores: { overall: data.overall },
    ephemeris_warning: data.ephemeris_warning || null, calculation_id: null,
  };
  state.report = data.report;
  state.access = data.access_token;
  state.isPaid = !!data.is_paid;
  state.showFull = state.isPaid;
}

/* Проверка оплаты: заново спрашиваем сервер по токену. Платную часть показываем
   только если сервер сам вернул is_paid: true. */
let paidChecking = false;
async function checkPaid(silent){
  if (paidChecking || !state.access) return;
  paidChecking = true;
  const msg = document.getElementById('paidMsg');
  const freeMode = PAYMENTS_ON === false;
  if (msg && !silent) msg.textContent = freeMode ? 'Открываем…' : 'Проверяем оплату…';
  try {
    const resp = await apiFetch('/api/compatibility/' + encodeURIComponent(state.access));
    if (resp.ok && resp.data) setPayments(resp.data.payments_enabled);
    if (resp.ok && resp.data && resp.data.is_paid){
      state.report = resp.data.report; state.isPaid = true; state.showFull = true; state.awaitingPayment = false;
      render({keepScroll: true, noIntro: true});
      const target = document.getElementById('fullStart');
      if (target) target.scrollIntoView({behavior: reduceMotion ? 'auto' : 'smooth', block: 'start'});
    } else if (msg && !silent){
      msg.textContent = freeMode ? 'Не удалось открыть полный разбор. Попробуйте ещё раз.' : (resp.ok
        ? 'Оплата пока не найдена. Если вы только что оплатили, подождите несколько секунд и нажмите ещё раз.'
        : 'Не удалось проверить оплату. Попробуйте ещё раз.');
    }
  } catch (e) {
    if (msg && !silent) msg.textContent = freeMode ? 'Не удалось открыть полный разбор. Проверьте соединение и попробуйте ещё раз.' : 'Не удалось проверить оплату. Проверьте соединение и попробуйте ещё раз.';
  } finally { paidChecking = false; }
}
document.addEventListener('visibilitychange', () => {
  if (document.visibilityState === 'visible' && SERVER_MODE && state.awaitingPayment && state.screen === 'report' && !state.isPaid) checkPaid(true);
});

