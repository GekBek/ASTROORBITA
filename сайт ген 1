  // mean daily motion n, deg/day). This is a simplified mean-longitude
  // ephemeris (no perturbations) — sufficient for an entertainment MVP
  // and fully deterministic. A production build should swap this module
  // for a real ephemeris library (e.g. Swiss Ephemeris) without touching
  // anything downstream, since everything below only consumes longitudes.
  const BODIES = {
    sun:     {L0: 280.459, n: 0.98564736},
    moon:    {L0: 218.316, n: 13.176396},
    mercury: {L0: 252.251, n: 4.092317},
    venus:   {L0: 181.980, n: 1.602136},
    mars:    {L0: 355.433, n: 0.524039},
    jupiter: {L0: 34.351,  n: 0.083056},
    saturn:  {L0: 50.077,  n: 0.033371},
  };

  const J2000 = Date.UTC(2000,0,1,12,0,0);

  function norm360(x){ x = x % 360; return x < 0 ? x + 360 : x; }

  // Small embedded city table so an Ascendant can actually be computed for
  // the most common birth cities without calling an external geocoding
  // service (none is reachable from this sandbox — see README). utcOffset
  // is a FIXED standard-time offset, i.e. it does NOT account for historical
  // daylight-saving rules. This is a documented MVP limitation: production
  // needs real geocoding + a historical timezone database (e.g. tz lookup).
  const CITY_TABLE = {
    'москва':        {lat:55.7558, lon:37.6173, utc:3},
    'санкт-петербург':{lat:59.9311, lon:30.3609, utc:3},
    'спб':           {lat:59.9311, lon:30.3609, utc:3},
    'новосибирск':   {lat:55.0084, lon:82.9357, utc:7},
    'екатеринбург':  {lat:56.8389, lon:60.6057, utc:5},
    'казань':        {lat:55.8304, lon:49.0661, utc:3},
    'нижний новгород':{lat:56.2965, lon:43.9361, utc:3},
    'челябинск':     {lat:55.1644, lon:61.4368, utc:5},
    'самара':        {lat:53.2001, lon:50.1500, utc:4},
    'омск':          {lat:54.9885, lon:73.3242, utc:6},
    'ростов-на-дону':{lat:47.2357, lon:39.7015, utc:3},
    'уфа':           {lat:54.7388, lon:55.9721, utc:5},
    'красноярск':    {lat:56.0184, lon:92.8672, utc:7},
    'воронеж':       {lat:51.6720, lon:39.1843, utc:3},
    'пермь':         {lat:58.0105, lon:56.2502, utc:5},
    'волгоград':     {lat:48.7080, lon:44.5133, utc:3},
    'киев':          {lat:50.4501, lon:30.5234, utc:2},
    'минск':         {lat:53.9006, lon:27.5590, utc:3},
    'алматы':        {lat:43.2220, lon:76.8512, utc:6},
    'астана':        {lat:51.1694, lon:71.4491, utc:5},
    'ташкент':       {lat:41.2995, lon:69.2401, utc:5},
    'баку':          {lat:40.4093, lon:49.8671, utc:4},
    'ереван':        {lat:40.1792, lon:44.4991, utc:4},
    'тбилиси':       {lat:41.7151, lon:44.8271, utc:4},
    'лондон':        {lat:51.5074, lon:-0.1278, utc:0},
    'париж':         {lat:48.8566, lon:2.3522,  utc:1},
    'берлин':        {lat:52.5200, lon:13.4050, utc:1},
    'рим':           {lat:41.9028, lon:12.4964, utc:1},
    'мадрид':        {lat:40.4168, lon:-3.7038, utc:1},
    'стамбул':       {lat:41.0082, lon:28.9784, utc:3},
    'дубай':         {lat:25.2048, lon:55.2708, utc:4},
    'нью-йорк':      {lat:40.7128, lon:-74.0060,utc:-5},
    'лос-анджелес':  {lat:34.0522, lon:-118.2437,utc:-8},
    'токио':         {lat:35.6762, lon:139.6503,utc:9},
    'пекин':         {lat:39.9042, lon:116.4074,utc:8},
    'дели':          {lat:28.6139, lon:77.2090, utc:5.5},
  };
  function findCity(cityName){
    if (!cityName) return null;
    const key = cityName.trim().toLowerCase();
    return CITY_TABLE[key] || null;
  }

  function daysSinceJ2000(dateStr, timeStr, utcOffsetHours){
    const [y,m,d] = dateStr.split('-').map(Number);
    let hh = 12, mm = 0; // default to local noon when time unknown
    if (timeStr){
      const [h,mi] = timeStr.split(':').map(Number);
      hh = h; mm = mi;
    }
    // When a real UTC offset is available (recognized city), convert local
    // clock time to UT. Otherwise (unrecognized/absent city) we fall back to
    // treating the given time as if it were UT — the original MVP
    // approximation — rather than silently guessing a timezone.
    if (typeof utcOffsetHours === 'number'){
      hh -= utcOffsetHours;
    }
    const ms = Date.UTC(y, m-1, d, hh, mm, 0);
    return (ms - J2000) / 86400000;
  }

  function longitudes(dateStr, timeStr, utcOffsetHours){
    const d = daysSinceJ2000(dateStr, timeStr, utcOffsetHours);
    const out = {};
    for (const key in BODIES){
      out[key] = norm360(BODIES[key].L0 + BODIES[key].n * d);
    }
    return out;
  }

  // Ascendant via Local Sidereal Time + latitude (standard spherical-astronomy
  // formula). Requires exact birth time AND a recognized birth city (for
  // latitude/longitude/UTC offset). This is the one "angle" this MVP computes
  // for real; full house cusps (Placidus etc.) are a materially larger piece
  // of astronomical math and are intentionally left as a documented gap.
  function computeAscendant(dateStr, timeStr, lat, lonEast, utcOffsetHours){
    const d = daysSinceJ2000(dateStr, timeStr, utcOffsetHours);
    const T = d / 36525;
    const gmst = norm360(280.46061837 + 360.98564736629*d + 0.000387933*T*T - (T*T*T)/38710000);
    const lst = norm360(gmst + lonEast); // local sidereal time, degrees
    const eps = 23.4393 * Math.PI/180;   // mean obliquity of the ecliptic
    const ramc = lst * Math.PI/180;
    const latRad = lat * Math.PI/180;
    const ascRad = Math.atan2(
      -Math.cos(ramc),
      Math.sin(ramc)*Math.cos(eps) + Math.tan(latRad)*Math.sin(eps)
    );
    return norm360(ascRad * 180/Math.PI);
  }

  function signIndex(lon){ return Math.floor(norm360(lon)/30); }

  // --- base sign-relationship score (Матрица §4) ---
  function signBase(iA, iB){
    let diff = Math.abs(iA - iB);
    diff = Math.min(diff, 12 - diff); // 0..6
    if (diff === 0) return 8;   // same sign
    if (diff === 4) return 9;   // same element (trine distance)
    if (diff === 2) return 7;   // sextile
    if (diff === 3) return 2;   // square
    if (diff === 6) return 3;   // opposition
    return 5;                   // neutral (1 or 5 signs apart)
  }

  // --- modality correction (Матрица §5) ---
  function modalityCorrection(iA, iB){
    const mA = SIGNS[iA].modality, mB = SIGNS[iB].modality;
    if (mA === mB) return 1;
    const set = [mA,mB].sort().join('-');
    if (set === 'cardinal-mutable') return 1;
    return 0; // cardinal-fixed or fixed-mutable
  }

  // --- aspect + orb (Матрица §6-7) ---
  const ASPECTS = [
    {angle:0,   score:10},
    {angle:60,  score:7},
    {angle:90,  score:-6},
    {angle:120, score:9},
    {angle:180, score:-7},
  ];
  function orbCoefficient(dev){
    if (dev <= 1) return 1.00;
    if (dev <= 2) return 0.90;
    if (dev <= 3) return 0.80;
    if (dev <= 4) return 0.65;
    if (dev <= 5) return 0.50;
    if (dev <= 6) return 0.30;
    if (dev <= 8) return 0.15;
    return 0;
  }
  function aspectScore(lonA, lonB){
    let diff = Math.abs(norm360(lonA) - norm360(lonB));
    if (diff > 180) diff = 360 - diff;
    let best = null;
    for (const a of ASPECTS){
      const dev = Math.abs(diff - a.angle);
      if (best === null || dev < best.dev) best = {dev, ...a};
    }
    const coef = orbCoefficient(best.dev);
    return best.score * coef; // range roughly -7..+10
  }

  // Special context override for Venus<->Mars affecting Conflict
  // (ТЗ §11 "Контекстное влияние")
  function venusMarsConflictScore(lonVenus, lonMars){
    let diff = Math.abs(norm360(lonVenus) - norm360(lonMars));
    if (diff > 180) diff = 360 - diff;
    const table = [
      {angle:0,   score:-3},
      {angle:60,  score:5},
      {angle:90,  score:-8},
      {angle:120, score:6},
      {angle:180, score:-7},
    ];
    let best = null;
    for (const a of table){
      const dev = Math.abs(diff - a.angle);
      if (best === null || dev < best.dev) best = {dev, ...a};
    }
    const coef = orbCoefficient(best.dev);
    return best.score * coef;
  }

  // --- normalize a single planetary pair to 0-100 (Матрица §9) ---
  function pairScore(lonA, lonB){
    const iA = signIndex(lonA), iB = signIndex(lonB);
    const base = signBase(iA, iB);
    const mod = modalityCorrection(iA, iB);
    const asp = aspectScore(lonA, lonB);
    const raw = 50 + (base - 5) * 4 + asp * 4 + mod * 2;
    return clamp(raw, 0, 100);
  }

  function clamp(v, lo, hi){ return Math.max(lo, Math.min(hi, v)); }

  // symmetric cross pair: average of A->B and B->A framing (§8)
  function sym(planetX, planetY, lonsA, lonsB){
    const s1 = pairScore(lonsA[planetX], lonsB[planetY]);
    const s2 = pairScore(lonsA[planetY], lonsB[planetX]);
    return (s1 + s2) / 2;
  }
  function direct(planet, lonsA, lonsB){
    return pairScore(lonsA[planet], lonsB[planet]);
  }

  function weighted(parts){
    // parts: [[score, weight], ...] weights need not pre-sum to 1; we normalize.
    const totalW = parts.reduce((s,p)=>s+p[1],0);
    const sum = parts.reduce((s,p)=>s+p[0]*p[1],0);
    return sum / totalW;
  }

  // simple deterministic numerology life-path number (helper for Goals)
  function lifePath(dateStr){
    let digits = dateStr.replace(/-/g,'').split('').map(Number);
    let sum = digits.reduce((a,b)=>a+b,0);
    while (sum > 9) sum = String(sum).split('').reduce((a,b)=>a+Number(b),0);
    return sum;
  }
  function numerologyScore(dateA, dateB){
    const a = lifePath(dateA), b = lifePath(dateB);
    const diff = Math.abs(a-b);
    return clamp(90 - diff*8, 20, 95);
  }

  function categoryScores(lonsA, lonsB, dateA, dateB, ascAvailable){
    const emotion = weighted([
      [direct('moon', lonsA, lonsB), 0.30],
      [sym('moon','sun', lonsA, lonsB), 0.20],
      [sym('moon','venus', lonsA, lonsB), 0.20],
      [sym('moon','mars', lonsA, lonsB), 0.10],
      [sym('moon','mercury', lonsA, lonsB), 0.10],
      [direct('sun', lonsA, lonsB), 0.10],
    ]);

    const attraction = weighted([
      [pairScore(lonsA.venus, lonsB.mars), 0.35],
      [pairScore(lonsA.mars, lonsB.venus), 0.35],
      [direct('venus', lonsA, lonsB), 0.10],
      [direct('mars', lonsA, lonsB), 0.10],
      [sym('sun','venus', lonsA, lonsB), 0.10],
    ]);

    // Ascendant is only available when BOTH people have an exact birth time
    // AND a recognized birth city. When available, use the weights from
    // Матрица §12 directly. When not, its weight is redistributed
    // proportionally onto Sun-Sun / Sun-Moon / "other", per the same §12
    // rule ("если время неизвестно... вес перераспределяется").
    const character = ascAvailable ? weighted([
      [direct('sun', lonsA, lonsB), 0.35],
      [sym('sun','moon', lonsA, lonsB), 0.25],
      [direct('asc', lonsA, lonsB), 0.20],
      [sym('sun','asc', lonsA, lonsB), 0.10],
      [direct('mercury', lonsA, lonsB), 0.10],
    ]) : weighted([
      [direct('sun', lonsA, lonsB), 0.50],
      [sym('sun','moon', lonsA, lonsB), 0.36],
      [direct('mercury', lonsA, lonsB), 0.14],
    ]);

    const communication = weighted([
      [direct('mercury', lonsA, lonsB), 0.40],
      [sym('mercury','moon', lonsA, lonsB), 0.20],
      [sym('mercury','sun', lonsA, lonsB), 0.20],
      [sym('mercury','venus', lonsA, lonsB), 0.10],
      [sym('sun','moon', lonsA, lonsB), 0.10],
    ]);

    const vmConflict = (venusMarsConflictScore(lonsA.venus, lonsB.mars) +
                         venusMarsConflictScore(lonsB.venus, lonsA.mars)) / 2;
    const vmConflictNorm = clamp(50 + vmConflict * 4, 0, 100);
    const conflict = weighted([
      [direct('mars', lonsA, lonsB), 0.30],
      [sym('mars','moon', lonsA, lonsB), 0.25],
      [sym('mars','mercury', lonsA, lonsB), 0.20],
      [vmConflictNorm, 0.15],
      [sym('saturn','sun', lonsA, lonsB), 0.10],
    ]);

    // Houses unavailable without geocoding -> weight redistributed onto
    // Moon / Venus / Saturn, per Матрица §15.
    const daily = weighted([
      [direct('moon', lonsA, lonsB), 0.30],
      [direct('venus', lonsA, lonsB), 0.25],
      [sym('moon','venus', lonsA, lonsB), 0.25],
      [sym('saturn','moon', lonsA, lonsB), 0.20],
    ]);

    // 2nd/10th houses unavailable -> redistributed onto Jupiter/Saturn/Sun,
    // numerology capped at 10% per Матрица §16.
    const goals = weighted([
      [direct('jupiter', lonsA, lonsB), 0.25],
      [direct('saturn', lonsA, lonsB), 0.25],
      [sym('sun','jupiter', lonsA, lonsB), 0.20],
      [sym('sun','saturn', lonsA, lonsB), 0.20],
      [numerologyScore(dateA, dateB), 0.10],
    ]);

    return {emotion, attraction, character, communication, conflict, daily, goals};
  }

  function round(v){ return Math.round(v); }

  function computeFuture(s){
    let future = s.emotion*0.20 + s.attraction*0.15 + s.character*0.15 +
                 s.communication*0.15 + s.conflict*0.15 + s.daily*0.10 + s.goals*0.10;
    if (s.emotion > 80 && s.communication > 80) future += 5;
    if (s.character > 80 && s.conflict > 80) future += 5;
    if (s.communication < 60) future -= 5;
    if (s.goals < 60) future -= 5;
    if (s.emotion >= 85 && s.communication >= 80) future += 4;
    if (s.emotion < 65 && s.conflict < 65) future -= 5;
    if (s.character >= 80 && s.daily >= 80) future += 5;
    return clamp(future, 0, 100);
  }

  function computeOverall(s){
    let overall = s.emotion*0.20 + s.attraction*0.20 + s.character*0.15 +
                  s.communication*0.15 + s.conflict*0.10 + s.daily*0.08 +
                  s.goals*0.07 + s.future*0.05;
    if (s.attraction >= 90) overall += 2;
    return clamp(overall, 0, 100);
  }

  function pickProfile(s){
    if (s.attraction >= 90 && s.conflict <= 65) return 'TYPE_INTENSE';
    if (s.attraction >= 90) return 'TYPE_01';
    if (s.emotion >= 85) return 'TYPE_02';
    if (s.daily >= 80 && s.conflict >= 75) return 'TYPE_04';
    if (s.attraction >= 85 && s.conflict < 70) return 'TYPE_05';
    return 'TYPE_03';
  }

  function pickStrength(s){
    const map = {emotion:'EMOTION', attraction:'ATTRACTION', character:'CHARACTER',
                 communication:'COMMUNICATION', daily:'DAILY', goals:'GOALS'};
    let best = null;
    for (const k in map){ if (!best || s[k] > s[best]) best = k; }
    return map[best];
  }
  function pickRisk(s){
    const map = {emotion:'EMOTION', communication:'COMMUNICATION', conflict:'CONFLICT',
                 daily:'DAILY', goals:'GOALS', attraction:'ATTRACTION'};
    let worst = null;
    for (const k in map){ if (!worst || s[k] < s[worst]) worst = k; }
    return s[worst] < 70 ? map[worst] : null;
  }

  // Deterministic calculation_id: a hash of the normalized inputs, NOT
  // Math.random(). This fixes the bug where re-running the same two people
  // through the calculator could get a different random ID and, since the
  // content engine's variant picker is keyed on calculation_id, could in
  // theory select different text variants for identical input. Same input
  // now always yields the same ID (and therefore the same variants) —
  // and, as a side benefit, re-submitting the same pair reuses one record
  // instead of creating a duplicate. Not cryptographically strong (this is
  // FNV-1a, chosen for zero dependencies); swap for SHA-256 in production.
  function fnv1a(str, seed){
    let h = seed >>> 0;
    for (let i = 0; i < str.length; i++){
      h ^= str.charCodeAt(i);
      h = Math.imul(h, 16777619) >>> 0;
    }
    return h >>> 0;
  }
  function deterministicId(personA, personB){
    const norm = p => [p.name||'', p.date||'', p.time||'', (p.city||'').trim().toLowerCase()].join('|');
    const input = norm(personA) + '::' + norm(personB);
    const h1 = fnv1a(input, 0x811c9dc5).toString(16).padStart(8,'0');
    const h2 = fnv1a(input.split('').reverse().join(''), 0x01000193).toString(16).padStart(8,'0');
    const h3 = fnv1a('salt:'+input, 0x9e3779b9).toString(16).padStart(8,'0');
    return `calc_${h1}${h2}${h3}`;
  }

  function calculate(personA, personB){
    const cityA = findCity(personA.city);
    const cityB = findCity(personB.city);

    // Precision is HIGH only when BOTH birth time and a recognized birth
    // city are available for both people (date+time+place, per ТЗ §24) —
    // both are required to compute a real Ascendant. Anything less is
    // STANDARD, even if a time was given but the city wasn't recognized.
    const highA = !!personA.time && !!cityA;
    const highB = !!personB.time && !!cityB;
    const precision = (highA && highB) ? 'HIGH' : 'STANDARD';

    const lonsA = longitudes(personA.date, personA.time, cityA ? cityA.utc : undefined);
    const lonsB = longitudes(personB.date, personB.time, cityB ? cityB.utc : undefined);

    let ascAvailable = false;
    if (highA && highB){
      lonsA.asc = computeAscendant(personA.date, personA.time, cityA.lat, cityA.lon, cityA.utc);
      lonsB.asc = computeAscendant(personB.date, personB.time, cityB.lat, cityB.lon, cityB.utc);
      ascAvailable = true;
    }

    const raw = categoryScores(lonsA, lonsB, personA.date, personB.date, ascAvailable);
    const scores = {
      emotion: round(raw.emotion), attraction: round(raw.attraction),
      character: round(raw.character), communication: round(raw.communication),
      conflict: round(raw.conflict), daily: round(raw.daily), goals: round(raw.goals),
    };
    scores.future = round(computeFuture(scores));
    scores.overall = round(computeOverall(scores));

    return {
      calculation_id: deterministicId(personA, personB),
      algorithm_version: '1.0',
      precision,
      ascendant_used: ascAvailable,
      created_at: new Date().toISOString(),
      person_a: {name: personA.name, date: personA.date, time: personA.time || null, city: personA.city || null},
      person_b: {name: personB.name, date: personB.date, time: personB.time || null, city: personB.city || null},
      planetary_longitudes: {a: lonsA, b: lonsB},
      scores,
      profile: pickProfile(scores),
      strength: pickStrength(scores),
      risk: pickRisk(scores),
    };
  }

  return {calculate};
})();

