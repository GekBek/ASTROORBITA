const DISCLAIMER = 'Развлекательный эзотерический сервис. Результаты не являются научным фактом, медицинским, финансовым или юридическим выводом.';

function renderLanding(){
  const p = state.step === 1 ? state.formData.a : state.formData.b;
  const prefix = state.step === 1 ? 'a' : 'b';
  const from = state.step === 1 ? 0 : 0.5;

  $app.innerHTML = `
    <main class="screen landing enter" id="main" tabindex="-1">
      <div class="brand-row"><div class="brand">${wordmark()}</div>${navTabs('compat')}</div>

      <section class="intro">
        <div class="intro-body">
          <h1 class="hero">Узнайте, насколько вы совместимы</h1>
