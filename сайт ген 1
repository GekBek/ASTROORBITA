  MX_MODULES.forEach(([modId, modLabel, secs]) => {
    const cards = [];
    secs.forEach(([sec, label]) => { const t = MatrixCore.lookup(db, pos, modId, sec, val); if (t) cards.push(mxSectionCard(label, t)); });
    /* разделы, появившиеся в базе позже и ещё не описанные в таблице заголовков */
    if (db[pos] && db[pos][modId]) Object.keys(db[pos][modId]).forEach(sec => {
      if (secs.some(s => s[0] === sec)) return;
      const t = MatrixCore.lookup(db, pos, modId, sec, val); if (t) cards.push(mxSectionCard(sec.replace(/_/g, ' '), t));
    });
    if (cards.length) blocks.push([modLabel, cards.join('')]);
  });
  if (!blocks.length && !R.programs.some(p => p.positions.split('-').includes(pos))) html += '<p class="rd-empty">' + MX_EMPTY + '</p>';
  blocks.forEach(([label, body]) => { html += (blocks.length > 1 ? '<h5 class="rd-mod">' + esc(label) + '</h5>' : '') + body; });
  return html;
}

/* -------------------------------------------------------------- экран */
function mxPrefill(){
  if (MX.touched) return;
  const fromCompat = state.formData && state.formData.a && state.formData.a.date;
  if (fromCompat){ MX.date = fromCompat; MX.dateRaw = null; MX.source = 'compat'; return; }
  try { const s = localStorage.getItem(MX_KEY); if (s){ MX.date = s; MX.dateRaw = null; MX.source = 'saved'; } } catch (e) {}
}

