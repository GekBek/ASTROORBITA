      <section class="panel" aria-labelledby="mxFormTitle">
        ${(MX.paid && MX.token && hasRes) ? `<div class="card" id="mxForm">
          <div class="offer-head"><span class="cat-ic">${ic('check')}</span><h2 class="t" id="mxFormTitle">Матрица оплачена</h2></div>
          <p class="sub">Дата рождения: <strong>${esc(mxFmtDate(MX.res.d, MX.res.m, MX.res.y))}</strong>. Эта страница открывается по вашей ссылке в любое время: сохраните её или найдите в боте по команде /my. По ссылке матрицу увидит любой, кому вы её перешлёте.</p>
          <div class="actions"><button type="button" class="btn btn-ghost" id="mxOther">Рассчитать для другой даты</button></div>
        </div>` : `<div class="card" id="mxForm">
          <div class="form-err ${MX.linkError ? 'show' : ''}" id="mxLinkErr" role="alert">${esc(MX.linkError)}</div>
          <h2 class="t" id="mxFormTitle">Ваша дата рождения</h2>
          <p class="sub">${MX.source === 'compat' ? 'Дата подставлена из вашего расчёта совместимости — её можно изменить.' : (MX.source === 'saved' ? 'Подставили дату прошлого расчёта — её можно изменить.' : 'Нужны день, месяц и год рождения.')}</p>
          <div class="field">
            <label for="mxDate">Дата рождения</label>
            <input id="mxDate" type="text" inputmode="numeric" maxlength="10" placeholder="ДД.ММ.ГГГГ" value="${escapeAttr(MX.dateRaw != null ? MX.dateRaw : isoToDateText(MX.date))}"
              autocomplete="off" enterkeyhint="go" aria-describedby="mxDateErr" aria-required="true" ${MX.err ? 'aria-invalid="true" class="invalid"' : ''} />
            <div class="field-err ${MX.err ? 'show' : ''}" id="mxDateErr" aria-live="polite">${ic('alert')}<span>${esc(MX.err)}</span></div>
          </div>
          <div class="actions"><button type="button" class="btn btn-primary" id="mxGo">${hasRes ? 'Пересчитать матрицу' : 'Рассчитать матрицу'}</button></div>
