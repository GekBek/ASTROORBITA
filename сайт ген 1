function mxAgeRange(key){
  const age = parseFloat(String(key).substring(3));
  const S = Math.floor(age / 10) * 10, off = Math.round((age - S) * 100) / 100;
  const r = { 1.25:[S+1, S+2.5], 2.5:[S+2.5, S+3.5], 3.75:[S+3.5, S+5], 5:[S+5], 6.25:[S+6, S+7.5], 7.5:[S+7.5, S+8.5], 8.75:[S+8.5, S+10] }[off];
  return r ? (r.length === 1 ? mxComma(r[0]) + ' лет' : mxComma(r[0]) + '–' + mxComma(r[1]) + ' лет') : mxComma(age);
}
