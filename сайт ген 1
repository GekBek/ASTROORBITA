};

function buildReport(calc){
  const vars = {
    name_a: calc.person_a.name, name_b: calc.person_b.name,
    overall: calc.scores.overall, emotion: calc.scores.emotion,
    attraction: calc.scores.attraction, character: calc.scores.character,
    communication: calc.scores.communication, conflict: calc.scores.conflict,
    daily: calc.scores.daily, goals: calc.scores.goals, future: calc.scores.future,
    profile: ContentDB.profiles[calc.profile]?.name || '', precision: calc.precision,
  };
  const F = (list, id) => ContentDB.fill(ContentDB.pickVariant(list, calc.calculation_id, id), vars);

  const catTexts = {};
  for (const key of Object.keys(ContentDB.categories)){
    const cat = ContentDB.categories[key];
    const score = calc.scores[key];
    catTexts[key] = {
      label: cat.label,
      score,
      text: F(cat[ContentDB.rangeFor(score)], key+'_TXT'),
    };
  }

  const specials = ContentDB.special.filter(sp => sp.cond(calc.scores));
  const overallLevel = calc.scores.overall >= 80 ? 'HIGH' : calc.scores.overall >= 60 ? 'MEDIUM' : 'LOW';

  return {
    intro: F(ContentDB.intro, 'INTRO'),
    overallText: F(ContentDB.overall[ContentDB.rangeFor(calc.scores.overall)], 'OVERALL_TXT'),
    categories: catTexts,
    strengthText: calc.strength ? ContentDB.fill(ContentDB.strength[calc.strength], vars) : null,
    riskText: calc.risk ? ContentDB.fill(ContentDB.risk[calc.risk], vars) : null,
    specials: specials.map(s => ContentDB.fill(s.text, vars)),
    profile: ContentDB.profiles[calc.profile],
    finalText: ContentDB.fill(ContentDB.final[overallLevel], vars),
  };
}

/* =========================================================================
   "BACKEND" LAYER — simulated persistence + the same shape the real
   Next.js API routes (POST /api/calculate, GET /api/calculations/:id,
   /free, /full) would return. Swapping localStorage for Postgres/Prisma
   later requires no change to the UI code below.
   ========================================================================= */
const Backend = {
  DB_KEY: 'compat_calculations_v1',
  _readDb(){ try { return JSON.parse(localStorage.getItem(this.DB_KEY) || '{}'); } catch(e){ return {}; } },
  _writeDb(db){ localStorage.setItem(this.DB_KEY, JSON.stringify(db)); },
  create(personA, personB){
    // calculation_id is deterministic (see Engine.deterministicId), so
    // re-submitting the same two people reuses the same record instead of
    // creating a duplicate row — this `db` write is effectively an upsert.
    const calc = Engine.calculate(personA, personB);
    const db = this._readDb();
    db[calc.calculation_id] = calc;
    this._writeDb(db);
    return calc;
  },
  get(id){ return this._readDb()[id] || null; },
  // Shapes a stored calculation into exactly the POST /api/compatibility
  // response contract, so this function is what becomes the Next.js route
  // handler's return value once Engine/ContentDB move server-side.
  toApiResponse(id){
    const calc = this.get(id);
    if (!calc) return null;
    const report = buildReport(calc);
    return {
      calculation_id: calc.calculation_id,
      precision: calc.precision,
      overall: calc.scores.overall,
      categories: {
        emotion: calc.scores.emotion, attraction: calc.scores.attraction,
        character: calc.scores.character, communication: calc.scores.communication,
        conflict: calc.scores.conflict, daily: calc.scores.daily,
        goals: calc.scores.goals, future: calc.scores.future,
      },
      profile: calc.profile,
      report,
    };
  },
};

