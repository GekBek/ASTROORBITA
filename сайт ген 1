
<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />
<meta name="theme-color" content="#FAF7F4" />
<meta name="color-scheme" content="light" />
<title>astroorbita — совместимость и матрица судьбы</title>
<style>
:root{
  color-scheme:light;
  --bg:#FAF7F4; --surface:#FFFFFF;
  --ink:#1F1B22; --ink-2:#4A4550; --muted:#6A6470;
  --line:#E3DBD5; --line-soft:#EFE9E4;
  --plum:#5E3A5A; --plum-hover:#6E4769; --plum-press:#4D2E49;
  --plum-tint:#F4EEF3; --plum-edge:#CDB9CB;
  --good:#5E3A5A; --mixed:#8A6786; --low:#A26558;
  --danger:#B3261E;
  --r-lg:24px; --r-md:16px; --r-sm:12px;
  --shadow:0 1px 2px rgba(31,27,34,.04),0 14px 34px -18px rgba(31,27,34,.16);
  --ease-out:cubic-bezier(.23,1,.32,1);
  --ease-in-out:cubic-bezier(.77,0,.175,1);
  --font:ui-sans-serif,-apple-system,BlinkMacSystemFont,"SF Pro Text","SF Pro Display","Segoe UI",Roboto,"Helvetica Neue",Arial,"Noto Sans",sans-serif;
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;-webkit-tap-highlight-color:transparent}
body{margin:0;background:var(--bg);color:var(--ink);font:400 1rem/1.55 var(--font);
  -webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;min-height:100vh;min-height:100svh}
h1,h2,h3,p,ul{margin:0}
button,a,[role=button]{touch-action:manipulation}
.shell{max-width:70rem;margin:0 auto;overflow-x:clip;
  padding:max(1.25rem,env(safe-area-inset-top)) max(1.25rem,env(safe-area-inset-right)) max(2.5rem,env(safe-area-inset-bottom)) max(1.25rem,env(safe-area-inset-left))}
.screen{outline:none}
.screen.enter{animation:rise 280ms var(--ease-out) both}
@keyframes rise{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
@keyframes fade{from{opacity:0}to{opacity:1}}
.reveal{animation:rise 360ms var(--ease-out) both;animation-delay:var(--d,0ms)}

/* ---------- icons & mark ---------- */
.ic{width:1.25rem;height:1.25rem;flex:none;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
.ic.sm{width:1rem;height:1rem}
.mark{display:block;width:100%;height:auto;overflow:visible}
.m-c{fill:rgba(94,58,90,.05);stroke:var(--plum);stroke-width:1.5px;vector-effect:non-scaling-stroke}
.m-o{fill:none;stroke:var(--plum-edge);stroke-width:1px;vector-effect:non-scaling-stroke}
.m-d{fill:var(--plum)}

/* ---------- brand ---------- */
.brand{display:inline-flex;align-items:center;gap:.6rem;font-weight:600;letter-spacing:-.01em;font-size:1.0625rem}

/* ---------- type ---------- */
.hero{font-weight:650;font-size:clamp(2.15rem,8.2vw,3.75rem);line-height:1.04;letter-spacing:-.036em;text-wrap:balance}
.lede{font-size:1.125rem;line-height:1.5;color:var(--ink-2);max-width:30rem;margin-top:1rem;text-wrap:pretty}
.t{font-size:1.375rem;line-height:1.2;letter-spacing:-.02em;font-weight:630}
.sub{color:var(--ink-2);font-size:.9375rem;line-height:1.5;margin-top:.35rem}

/* ---------- landing ---------- */
.landing{display:grid;gap:1.75rem}
.landing .intro{position:relative}
.landing .intro-body{position:relative;z-index:1}
.landing .mark-lg{position:absolute;top:-3.2rem;right:-6.5rem;width:14.5rem;opacity:.34;pointer-events:none;z-index:0}
.landing .brand-row{padding-top:.25rem}
.points{display:flex;flex-wrap:wrap;gap:.5rem;list-style:none;padding:0;margin-top:1.4rem}
.points li{display:inline-flex;align-items:center;gap:.45rem;padding:.4rem .8rem .4rem .6rem;border:1px solid var(--line);
  border-radius:999px;background:var(--surface);font-size:.875rem;color:var(--ink-2)}
.points .ic{width:1rem;height:1rem;color:var(--plum)}
.panel{min-width:0}
.disclaimer{color:var(--muted);font-size:.8125rem;line-height:1.55;text-align:center;max-width:40rem;margin:.5rem auto 0;text-wrap:pretty}
@media (max-width:959px){.landing .mark-lg .m-d{display:none}}
@media (min-width:960px){
  .shell{padding-top:2.25rem}
  .landing{grid-template-columns:minmax(0,1fr) minmax(0,28.5rem);column-gap:5rem;row-gap:0;align-items:center;min-height:calc(100svh - 6rem)}
  .landing .brand-row{grid-column:1/-1;align-self:start}
  .landing .intro{align-self:center}
  .landing .mark-lg{position:static;width:min(24rem,100%);opacity:.8;margin:2.5rem 0 0 -1rem}
  .landing .disclaimer{grid-column:1/-1;align-self:end}
}

/* ---------- cards & forms ---------- */
.card{background:var(--surface);border:1px solid var(--line-soft);border-radius:var(--r-lg);box-shadow:var(--shadow);padding:1.5rem}
@media (max-width:480px){.card{padding:1.25rem;border-radius:20px}}
.stepper{display:flex;align-items:center;gap:.9rem;margin-bottom:1rem}
.stepper .bar{flex:1;height:4px;border-radius:4px;background:var(--line);overflow:hidden}
.stepper .bar i{display:block;height:100%;background:var(--plum);transform-origin:left;transform:scaleX(var(--p,0));transition:transform 420ms var(--ease-out)}
.stepper span{font-size:.8125rem;letter-spacing:.01em;color:var(--muted);font-variant-numeric:tabular-nums}
.field{display:grid;gap:.4rem;margin-top:1.15rem}
.field>label{font-size:.9375rem;font-weight:560}
.field .opt{font-weight:400;color:var(--muted);margin-left:.35rem;font-size:.8125rem}
.hint{font-size:.8125rem;color:var(--muted);line-height:1.4}
input[type=text],input[type=date],input[type=time]{
  -webkit-appearance:none;appearance:none;width:100%;min-height:3.25rem;padding:.75rem .95rem;
  font:inherit;font-size:max(16px,1rem);color:var(--ink);background:#fff;border:1px solid var(--line);border-radius:var(--r-sm);
  transition:border-color 160ms var(--ease-out),box-shadow 160ms var(--ease-out),background-color 160ms var(--ease-out)}
input::placeholder{color:#857F8C;opacity:1}
input::-webkit-date-and-time-value{text-align:left}
input:focus{outline:none;border-color:var(--plum);box-shadow:0 0 0 4px rgba(94,58,90,.18)}
input:disabled{background:var(--bg);color:var(--muted);cursor:not-allowed}
input.invalid{border-color:var(--danger);box-shadow:0 0 0 4px rgba(179,38,30,.12)}
.field-err{display:none;align-items:flex-start;gap:.45rem;font-size:.875rem;line-height:1.4;color:var(--danger)}
.field-err.show{display:flex}
.field-err .ic{width:1rem;height:1rem;margin-top:.1rem}
.toggle{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-top:.9rem;padding:.7rem .95rem;min-height:3.25rem;
  border:1px solid var(--line-soft);background:var(--bg);border-radius:var(--r-sm);cursor:pointer;user-select:none;-webkit-user-select:none;font-size:.9375rem}
.switch{position:relative;width:2.9rem;height:1.75rem;flex:none}
.switch input{position:absolute;inset:0;width:100%;height:100%;margin:0;opacity:0;cursor:pointer}
.switch .track{position:absolute;inset:0;border-radius:999px;background:#948D9A;transition:background-color 200ms var(--ease-out)}
.switch .knob{position:absolute;top:.2rem;left:.2rem;width:1.35rem;height:1.35rem;border-radius:50%;background:#fff;box-shadow:0 1px 3px rgba(0,0,0,.28);transition:transform 200ms var(--ease-out)}
.switch input:checked+.track{background:var(--plum)}
.switch input:checked+.track .knob{transform:translateX(1.15rem)}
.switch input:focus-visible+.track{outline:2px solid var(--plum);outline-offset:3px}

/* ---------- buttons ---------- */
.btn{-webkit-appearance:none;appearance:none;border:0;font:inherit;font-weight:600;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:.55rem;
  min-height:3.25rem;border-radius:var(--r-md);text-decoration:none;user-select:none;-webkit-user-select:none;-webkit-touch-callout:none;
  transition:transform 160ms var(--ease-out),background-color 160ms var(--ease-out),border-color 160ms var(--ease-out)}
.btn:active{transform:scale(.97)}
.btn:focus-visible,a:focus-visible{outline:2px solid var(--plum);outline-offset:3px}
.btn-primary{background:var(--plum);color:#fff;padding:.9rem 1.5rem;font-size:1.0625rem;box-shadow:0 10px 22px -12px rgba(94,58,90,.7)}
.btn-primary:active{background:var(--plum-press)}
.btn-icon{width:3.25rem;padding:0;background:#fff;border:1px solid var(--line);color:var(--ink)}
.btn-ghost{background:transparent;color:var(--plum);padding:.45rem .8rem;min-height:2.75rem;font-size:.9375rem}
.btn-dark{background:var(--ink);color:#fff;padding:.9rem 1.5rem;font-size:1.0625rem}
.btn-dark:active{background:#000}
@media (hover:hover) and (pointer:fine){
  .btn-primary:hover{background:var(--plum-hover)}
  .btn-icon:hover{border-color:var(--plum-edge);background:var(--plum-tint)}
  .btn-ghost:hover{background:var(--plum-tint)}
  .btn-dark:hover{background:#352f3a}
}
.form-err{display:none;margin-top:1.2rem;padding:.7rem .9rem;border-radius:var(--r-sm);background:#FCEEEC;color:var(--danger);font-size:.9375rem;line-height:1.4}
.form-err.show{display:block}
.form-err+.actions{margin-top:.8rem}
.actions{display:flex;gap:.75rem;margin-top:1.4rem}
.actions .btn-primary{flex:1;min-width:0}

/* ---------- calculating ---------- */
.calc{min-height:calc(100svh - 5rem);display:grid;place-content:center;justify-items:center;text-align:center;gap:1.1rem}
.calc-mark{width:9.5rem}
.calc-title{font-size:1.5rem;letter-spacing:-.025em;font-weight:630;max-width:20rem;text-wrap:balance}
.loading-track{width:min(16rem,70vw);height:4px;border-radius:4px;background:var(--line);overflow:hidden}
.loading-track i{display:block;height:100%;background:var(--plum);transform-origin:left;transform:scaleX(.05);transition:transform 380ms var(--ease-out)}
.loading-step{min-height:1.6em;color:var(--ink-2);font-size:.9375rem;transition:opacity 180ms var(--ease-out)}
.calc .m-c1{animation:join-l 1500ms var(--ease-in-out) both}
.calc .m-c2{animation:join-r 1500ms var(--ease-in-out) both}
@keyframes join-l{from{transform:translateX(-34px)}to{transform:none}}
@keyframes join-r{from{transform:translateX(34px)}to{transform:none}}

/* ---------- report ---------- */
.topbar{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-bottom:1.25rem}
.report{display:grid;gap:1rem}
.report-side,.report-main{display:grid;gap:1rem;align-content:start;min-width:0}
.names{font-size:clamp(1.65rem,6vw,2.5rem);line-height:1.1;letter-spacing:-.032em;font-weight:650;overflow-wrap:anywhere;text-wrap:balance}
.names .plus{color:#96779A;font-weight:400;padding:0 .2em}
.note{display:flex;gap:.55rem;align-items:flex-start;color:var(--ink-2);font-size:.875rem;line-height:1.45;margin-top:.55rem}
.note .ic{width:1.05rem;height:1.05rem;margin-top:.1rem;color:var(--plum)}
.overall{display:grid;justify-items:center;gap:1.1rem;text-align:center;padding:1.75rem 1.5rem}
.ring{position:relative;width:10.75rem;height:10.75rem}
.ring svg{width:100%;height:100%;transform:rotate(-90deg)}
.ring .bg{fill:none;stroke:var(--line-soft);stroke-width:7}
.ring .fg{fill:none;stroke-width:7;stroke-linecap:round;transition:stroke-dashoffset 1000ms var(--ease-out)}
.ring-num{position:absolute;inset:0;display:grid;place-content:center;text-align:center}
.ring-num .n{font-size:3rem;font-weight:650;letter-spacing:-.04em;line-height:1;font-variant-numeric:tabular-nums}
.ring-num .n span{font-size:1.25rem;font-weight:550;color:var(--muted);margin-left:.1rem;letter-spacing:0}
.ring-num .lvl{margin-top:.4rem;font-size:.875rem;font-weight:600;color:var(--plum)}
.overall-text{color:var(--ink-2);max-width:30rem;text-wrap:pretty}
.card-title{font-size:1.125rem;font-weight:630;letter-spacing:-.015em}
.cat{padding:1.1rem 0;border-top:1px solid var(--line-soft)}
.cat:first-of-type,.card-title+.cat{border-top:0}
.card-title+.cat{padding-top:.95rem}
.cat-head{display:flex;align-items:center;gap:.7rem}
.cat-ic{width:2.1rem;height:2.1rem;border-radius:11px;background:var(--plum-tint);color:var(--plum);display:grid;place-items:center;flex:none}
.cat-ic.risk{background:#F8EEE9;color:#8A4C40}
.cat-t{flex:1;min-width:0}
.cat-t h3{font-size:1rem;font-weight:600;line-height:1.25}
.cat-lvl{font-size:.8125rem;color:var(--muted)}
.cat-score{font-variant-numeric:tabular-nums;font-weight:650;font-size:1.25rem;letter-spacing:-.02em}
.cat-score span{font-size:.875rem;font-weight:550;color:var(--muted);margin-left:.05rem}
.meter{height:6px;border-radius:6px;background:var(--line-soft);overflow:hidden;margin:.8rem 0}
.meter i{display:block;height:100%;width:100%;background:var(--c,var(--plum));transform-origin:left;transform:scaleX(0);transition:transform 800ms var(--ease-out)}
.cat p,.prose{color:var(--ink-2);line-height:1.62;text-wrap:pretty}
.note-card{display:grid;grid-template-columns:auto 1fr;gap:.9rem;align-items:start}
.note-card h3{font-size:1rem;font-weight:600;margin-bottom:.3rem}
.note-card p{color:var(--ink-2);line-height:1.6;text-wrap:pretty}
.offer{border-color:var(--plum-edge)}
.offer-head{display:flex;align-items:center;gap:.7rem}
.offer .lead{color:var(--ink-2);margin-top:.9rem;line-height:1.55}
.learn{list-style:none;padding:0;display:grid;gap:.75rem;margin-top:1.1rem}
.learn li{display:grid;grid-template-columns:1.25rem 1fr;gap:.7rem;color:var(--ink-2);font-size:.96875rem;line-height:1.5}
.learn .ic{color:var(--plum);margin-top:.12rem}
.chips-label{font-size:.8125rem;color:var(--muted);margin-top:1.25rem;font-weight:550}
.chips{display:flex;flex-wrap:wrap;gap:.45rem;list-style:none;padding:0;margin-top:.55rem}
.chips li{font-size:.8125rem;padding:.3rem .7rem;border-radius:999px;background:var(--plum-tint);color:var(--plum);font-weight:560}
.buy{display:grid;gap:.9rem;margin-top:1.3rem;padding-top:1.3rem;border-top:1px solid var(--line-soft)}
.price{display:flex;align-items:baseline;justify-content:space-between;flex-wrap:wrap;gap:.25rem .75rem;color:var(--ink-2)}
.price strong{font-size:1.5rem;letter-spacing:-.025em;color:var(--ink);font-weight:650;white-space:nowrap}
.price .note{margin:0}
.area-title{font-size:1.5rem;letter-spacing:-.025em;font-weight:650;scroll-margin-top:1rem;margin-top:.25rem}
.sec-head{display:flex;align-items:center;gap:.7rem}
.special{padding:.85rem 0;border-top:1px solid var(--line-soft);color:var(--ink-2);line-height:1.6;text-wrap:pretty}
.sec-head+.special{border-top:0;margin-top:.35rem}
.profile-name{font-size:1.5rem;letter-spacing:-.028em;font-weight:650;margin:.7rem 0 .5rem;line-height:1.15}
.tg{width:100%}
.trust{display:flex;flex-wrap:wrap;gap:.45rem 1.4rem;justify-content:center;color:var(--muted);font-size:.8125rem}
.trust span{display:inline-flex;align-items:center;gap:.4rem}
.ref{font-size:.75rem;color:var(--muted);text-align:center;overflow-wrap:anywhere;font-variant-numeric:tabular-nums}
.tail{display:grid;gap:.85rem}
@media (min-width:1024px){
  .shell{padding-top:2.25rem}
  .report{grid-template-columns:minmax(0,23.5rem) minmax(0,1fr);column-gap:2.75rem}
  .report-side{position:sticky;top:1.5rem}
}

/* ---------- accessibility ---------- */
@media (prefers-reduced-motion:reduce){
  .screen.enter,.reveal{animation:fade 160ms linear both !important;animation-delay:0ms !important}
  .calc .m-c1,.calc .m-c2{animation:none !important}
  .ring .fg,.meter i,.stepper .bar i,.loading-track i{transition:none !important}
  .btn,.switch .track,.switch .knob,input{transition-duration:.01ms !important}
}
@media (prefers-contrast:more){
  :root{--line:#8F8894;--line-soft:#B5AEB9;--muted:#4F4A55}
  .card{box-shadow:none}
}

/* ---------- section switch ---------- */
.brand-row{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:.9rem 1.25rem}
.nav{display:inline-flex;gap:.25rem;padding:.25rem;background:var(--surface);border:1px solid var(--line);border-radius:999px}
.nav a{display:inline-flex;align-items:center;justify-content:center;gap:.45rem;min-height:2.5rem;padding:0 1rem;border-radius:999px;color:var(--ink-2);
  text-decoration:none;font-size:.9375rem;font-weight:560;white-space:nowrap;transition:background-color 160ms var(--ease-out),color 160ms var(--ease-out),transform 160ms var(--ease-out)}
.nav a:active{transform:scale(.97)}
.nav a[aria-current=page]{background:var(--plum);color:#fff}
@media (hover:hover) and (pointer:fine){.nav a:not([aria-current=page]):hover{background:var(--plum-tint);color:var(--plum)}}
@media (max-width:560px){.brand-row .nav{width:100%}.nav a{flex:1;padding:0 .5rem}}

/* ---------- Destiny Matrix ---------- */
.matrix.landing{min-height:0}
.matrix .mx-result{grid-column:1/-1;margin-top:1rem;min-width:0;scroll-margin-top:1rem}
.mx-grid{display:grid;gap:1rem;margin-top:1rem}
.mx-a,.mx-b,.mx-c{display:grid;gap:1rem;align-content:start;min-width:0}
.mx-chart-card{padding:1rem}
.mx-svg{display:block;width:100%;height:auto;max-height:80vh}
.mx-svg text{font-family:var(--font)}
.mx-svg .ln{fill:none;stroke-linejoin:round}
.mx-svg .ring{stroke:var(--line);stroke-width:1.2}
.mx-svg .ring2{stroke:var(--line-soft);stroke-width:1.2}
.mx-svg .ring3{stroke:var(--plum-edge);stroke-width:1;stroke-dasharray:3 7}
.mx-svg .oct{stroke:var(--plum-edge);stroke-width:1.6}
.mx-svg .dia{stroke:#B79AB3;stroke-width:1.6}
.mx-svg .dia2{stroke:var(--line);stroke-width:1.3;stroke-dasharray:5 5}
.mx-svg .diag1{stroke:var(--plum-edge);stroke-width:1.8}
.mx-svg .diag2{stroke:#E3C2B8;stroke-width:1.8}
.mx-svg .axis{stroke:var(--line);stroke-width:1.2;stroke-dasharray:5 5}
.mx-cap text{font-size:11px;letter-spacing:.14em;fill:var(--muted);font-weight:600}
.mx-svg .dec{font-size:12px;fill:var(--muted);font-weight:600}
.mx-n{cursor:pointer;outline:none}
.mx-n .hit{fill:transparent;stroke:transparent}
.mx-n .c{stroke-width:1.6;transition:stroke-width 160ms var(--ease-out),stroke 160ms var(--ease-out)}
.mx-n .v{text-anchor:middle;dominant-baseline:central;font-weight:650;pointer-events:none;font-variant-numeric:tabular-nums}
.g-core .c{fill:#5E3A5A;stroke:#5E3A5A}.g-core .v{fill:#fff}
.g-center .c{fill:#3F2440;stroke:#3F2440}.g-center .v{fill:#fff}
.g-line .c{fill:#F4EEF3;stroke:#B79AB3}.g-line .v{fill:#1F1B22}
.g-talent .c{fill:#F6EDE3;stroke:#C9AE92}.g-talent .v{fill:#1F1B22}
.g-chan .c{fill:#FBEEEA;stroke:#D8A99D}.g-chan .v{fill:#1F1B22}
.mx-n.age .c{fill:#fff;stroke:#CDB9CB;stroke-width:1.2}
.mx-n.age .v{font-size:12.5px;fill:var(--ink-2);font-weight:600}
.mx-n.prog .hit{stroke:#A26558;stroke-width:1.4;stroke-dasharray:3 3}
.mx-n:focus-visible .hit{stroke:var(--plum);stroke-width:2;fill:rgba(94,58,90,.08)}
.mx-n.now .c{stroke:#A26558;stroke-width:3.4}
.mx-n.active .hit{stroke:var(--ink);stroke-width:2.6}
.mx-n.active .c{stroke-width:3}
@media (hover:hover) and (pointer:fine){.mx-n:hover .c{stroke:var(--plum);stroke-width:3}}
.mx-svg.compact .mx-ring{display:none}
.mx-legend{list-style:none;display:flex;flex-wrap:wrap;gap:.4rem 1rem;padding:0;margin:.75rem 0 0;font-size:.8125rem;color:var(--ink-2)}
.sw{display:inline-block;width:.8rem;height:.8rem;border-radius:50%;margin-right:.4rem;vertical-align:-.1rem;border:1.5px solid}
.sw.g-core{background:#5E3A5A;border-color:#5E3A5A}.sw.g-line{background:#F4EEF3;border-color:#B79AB3}
.sw.g-talent{background:#F6EDE3;border-color:#C9AE92}.sw.g-chan{background:#FBEEEA;border-color:#D8A99D}
.sw.now{background:#fff;border-color:#A26558;border-width:2.5px}
.mx-hint{font-size:.875rem;color:var(--muted);margin-top:.5rem}
.mx-card{padding:1.25rem}
.mx-age-row{display:flex;gap:.75rem;align-items:flex-end;margin-top:.25rem}
.mx-age-row .field{margin-top:0;flex:1;min-width:0}
.mx-age-row .btn{min-width:7rem}
.mx-card .field-err{margin-top:.5rem}
details>summary{cursor:pointer;list-style:none;display:flex;align-items:center;min-height:2.75rem;font-weight:600;border-radius:var(--r-sm)}
details>summary::-webkit-details-marker{display:none}
