  mxMarkNodes();
}

function mxOpen(pos, opts){
  opts = opts || {};
  MX.active = pos;
  if (!opts.forecast){ MX.forecastAge = null; MX.forecastKeyFor = null; }
  mxRenderReading();
  const el = document.getElementById('mxReading');
  if (el && window.matchMedia && matchMedia('(max-width: 1023px)').matches){
