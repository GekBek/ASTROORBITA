function mxCompute(chk){
  const vals = MatrixCore.calc(chk.d, chk.m, chk.y);
  const age = MatrixCore.calculateAge(chk.d, chk.m, chk.y);
  MX.res = { d: chk.d, m: chk.m, y: chk.y, vals, age, programs: MX.paid ? MatrixCore.activePrograms(mxDB(), vals) : [] };
}

/* Демо-режим (сервер не подключён): «оплата» открывает всё без оплаты, тексты уже на странице. */
/* Оплата отключена: «Открыть полный разбор». Сервер отдаёт платные тексты именно этой даты; в демо они уже в странице. */
async function mxOpenFree(){
  if (!SERVER_MODE){ mxDemoUnlock(); return; }
  const msg = document.getElementById('mxOpenMsg'); if (msg) msg.textContent = 'Открываем…';
  let resp = null;
  try { resp = await apiFetch('/api/matrix/open', { method: 'POST', body: JSON.stringify({ date: mxIso() }) }); } catch (e) {}
  if (resp && resp.ok && resp.data && resp.data.paid_texts){
    mxMergeDb(resp.data.paid_texts);
    MX.paid = true; MX.paidDate = MX.date;
    MX.res.programs = MatrixCore.activePrograms(mxDB(), MX.res.vals);
    render({keepScroll: true, noIntro: true});
    return;
  }
  const m2 = document.getElementById('mxOpenMsg');
  if (m2) m2.textContent = (resp && resp.status === 403) ? 'Полный разбор сейчас доступен только после оплаты.' : 'Не удалось открыть полный разбор. Попробуйте ещё раз.';
}
