/* Ввод даты цифрами: «ДД.ММ.ГГГГ», точки подставляются сами (на телефоне — цифровая
   клавиатура вместо календаря). Внутри приложения дата по-прежнему «ГГГГ-ММ-ДД». */
function maskDateText(raw){
  const s = String(raw == null ? '' : raw).trim();
  const iso = /^(\d{4})-(\d{2})-(\d{2})$/.exec(s);
  if (iso) return iso[3] + '.' + iso[2] + '.' + iso[1];
  const d = s.replace(/\D/g, '').slice(0, 8);
  let out = d.slice(0, 2);
  if (d.length > 2) out += '.' + d.slice(2, 4);
  if (d.length > 4) out += '.' + d.slice(4);
  return out;
}
function dateTextToISO(txt){
  const m = /^(\d{2})\.(\d{2})\.(\d{4})$/.exec(String(txt || '').trim());
  return m ? m[3] + '-' + m[2] + '-' + m[1] : '';
}
function isoToDateText(iso){
  const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(String(iso || ''));
  return m ? m[3] + '.' + m[2] + '.' + m[1] : '';
}
function isRealPastDate(iso){
  const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(String(iso || ''));
  if (!m) return false;
  const y = +m[1], mo = +m[2], d = +m[3], dt = new Date(y, mo - 1, d);
  if (y < 1900 || dt.getFullYear() !== y || dt.getMonth() !== mo - 1 || dt.getDate() !== d) return false;
  const t = new Date();
  return dt <= new Date(t.getFullYear(), t.getMonth(), t.getDate());
}
function bindDateMask(el, onChange){
  el.addEventListener('input', () => {
    const v = maskDateText(el.value);
    if (v !== el.value) el.value = v;
    if (onChange) onChange();
  });
}

