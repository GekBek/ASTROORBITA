function renderCalculating(){
  const steps = [
    'Анализируем ваши даты рождения',
    'Определяем эмоциональную совместимость',
    'Рассчитываем силу притяжения',
    'Анализируем особенности общения',
    'Определяем потенциал отношений',
  ];
  $app.innerHTML = `
    <main class="screen calc enter" id="main" tabindex="-1">
      <div class="calc-mark">${orbitMark()}</div>
      <h1 class="calc-title">Рассчитываем вашу совместимость</h1>
      <div class="loading-track" aria-hidden="true"><i id="loadBar"></i></div>
      <p class="loading-step" id="stepText" aria-live="polite">${steps[0]}</p>
    </main>
  `;
  let i = 0;
  const stepEl = document.getElementById('stepText');
  const barEl = document.getElementById('loadBar');
  requestAnimationFrame(() => { barEl.style.transform = `scaleX(${1 / steps.length})`; });
  const iv = setInterval(() => {
    if (!document.body.contains(stepEl)) { clearInterval(iv); return; }
    if (i >= steps.length - 1) { clearInterval(iv); return; }
    i += 1;
    stepEl.style.opacity = 0;
    barEl.style.transform = `scaleX(${(i + 1) / steps.length})`;
    setTimeout(() => { stepEl.textContent = steps[i]; stepEl.style.opacity = 1; }, 180);
  }, 380);
}

/* ----------------------------------------------------------------- report */

function levelInfo(score){
  if (score >= 90) return {label:'Очень высокая', color:'var(--good)'};
  if (score >= 80) return {label:'Высокая', color:'var(--good)'};
  if (score >= 70) return {label:'Хорошая', color:'var(--mixed)'};
  if (score >= 60) return {label:'Смешанная', color:'var(--mixed)'};
  return {label:'Низкая', color:'var(--low)'};
}

/* One category: icon + title + level + score, meter, own explanation. */
/* «Почему такой процент»: главные контакты планет (бесплатно — один, в платной части — все) или честное «ничего яркого». */
function whyBlock(notes, neutral){
  const items = (notes || []).map((n) => `<div class="why-i"><div class="why-t">${esc(n.title)}${n.approx ? ' <span class="why-approx">приблизительно</span>' : ''}</div><p>${esc(n.text)}</p></div>`).join('');
  if (!items && !neutral) return '';
  return `<div class="why"><div class="why-h">${ic('info','sm')}Почему такой процент</div>${items || `<p>${esc(neutral)}</p>`}</div>`;
}

function catItem(key, cat, title, extra){
  const lvl = levelInfo(cat.score);
  const more = extra ? `
      ${(extra.manifestation && extra.manifestation !== cat.text) ? `<p class="manifest">${esc(extra.manifestation)}</p>` : ''}
      ${whyBlock(extra.why, extra.whyNeutral)}
      ${extra.tip ? `<p class="tip"><strong>Совет.</strong> ${esc(extra.tip)}</p>` : ''}` : '';
  return `
    <div class="cat">
      <div class="cat-head">
        <span class="cat-ic">${ic(key)}</span>
        <div class="cat-t"><h3>${esc(title || cat.label)}</h3><span class="cat-lvl">${lvl.label}</span></div>
        <span class="cat-score">${cat.score}<span>%</span></span>
      </div>
      <div class="meter" role="img" aria-label="${esc(title || cat.label)}: ${cat.score}%"><i data-w="${cat.score}" style="--c:${lvl.color}"></i></div>
      <p>${esc(cat.text)}</p>${more}
    </div>
  `;
}

/* Что показать в сфере: бесплатно — «как проявляется» и один контакт; после оплаты — всё (контакты, совет). */
function catExtra(r, key){
  if (state.showFull && r.categoryExtras && r.categoryExtras[key]){
    const x = r.categoryExtras[key];
    return { manifestation: x.manifestation, why: x.why, whyNeutral: x.whyNeutral, tip: x.tip };
  }
  if (r.categoryFree && r.categoryFree[key]){
    const x = r.categoryFree[key];
    return { manifestation: x.manifestation, why: x.why ? [x.why] : [], whyNeutral: x.why ? null : x.whyNeutral };
  }
  return null;
}

function tipsList(tips){
  return (tips && tips.length) ? `<ul class="tips">${tips.map((t) => `<li>${ic('check','sm')}<span>${esc(t)}</span></li>`).join('')}</ul>` : '';
}

