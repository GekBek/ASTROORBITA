          <div class="form-err${state.calcError ? ' show' : ''}" id="formErr" role="alert">${esc(state.calcError)}</div>
          <div class="actions">
            ${state.step === 2 ? `<button type="button" class="btn btn-icon" id="backBtn" aria-label="Назад">${ic('back')}</button>` : ''}
            <button type="button" class="btn btn-primary" id="nextBtn">${state.step === 1 ? `Далее${ic('next')}` : 'Рассчитать совместимость'}</button>
          </div>
        </form>
      </section>

      <p class="disclaimer">${DISCLAIMER}</p>
    </main>
  `;

  state.calcError = '';
  trackEvent('landing_view', 'page');
  document.getElementById('stepForm').addEventListener('input', () => trackEvent('form_started', 'page'), { once: true });
  bindDateMask(document.getElementById(`${prefix}_date`));

  const skipEl = document.getElementById(`${prefix}_skip`);
  skipEl.addEventListener('change', () => {
    document.getElementById(`${prefix}_time`).disabled = skipEl.checked;
  });

  const advance = () => { state.step === 1 ? goNext() : onSubmit(); };
  const form = document.getElementById('stepForm');
  form.addEventListener('submit', (e) => { e.preventDefault(); });
  document.getElementById('nextBtn').addEventListener('click', advance);
  form.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && e.target.tagName === 'INPUT' && e.target.type !== 'checkbox'){ e.preventDefault(); advance(); }
  });
  const backBtn = document.getElementById('backBtn');
  if (backBtn) backBtn.addEventListener('click', goBack);

  const bar = document.getElementById('stepBar');
  requestAnimationFrame(() => requestAnimationFrame(() => bar.style.setProperty('--p', state.step / 2)));
