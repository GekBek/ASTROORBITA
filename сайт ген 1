}

/* Только для локального сервера: весь путь «бот → оплата» одним нажатием. */
async function mxDevPay(){
  try {
    const r = await apiFetch(window.SITE_DEV.matrixPayUrl, { method: 'POST', body: JSON.stringify({ date: mxIso() }) });
    if (r.ok && r.data && r.data.access_token){
      try { location.hash = '#m=' + r.data.access_token; } catch (e) {}
      applyRoute({ kind: 'matrix-link', token: r.data.access_token });
    }
  } catch (e) {}
}

/* Открыть матрицу по ссылке из бота (#m=<токен>). true — получилось. */
async function mxLoadByToken(token){
  MX.linkError = '';
  let resp = null;
  try { resp = await apiFetch('/api/matrix/' + encodeURIComponent(token)); } catch (e) {}
  if (!resp || !resp.ok || !resp.data || !resp.data.birth_date){
    MX.linkError = resp && resp.status === 404
      ? 'Ссылка недействительна или устарела. Проверьте, что вы открыли её целиком.'
      : 'Не удалось загрузить матрицу. Проверьте соединение и попробуйте ещё раз.';
    return false;
  }
  const d = resp.data, chk = MatrixCore.validateDate(d.birth_date);
  if (!chk.ok){ MX.linkError = 'Не удалось прочитать дату матрицы.'; return false; }
  mxResetPaid();
  MX.date = d.birth_date; MX.dateRaw = null; MX.source = 'link'; MX.touched = true; MX.err = '';
  MX.token = token;
  if (d.is_paid && d.paid_texts){ mxMergeDb(d.paid_texts); MX.paid = true; MX.paidDate = d.birth_date; }
  mxCompute(chk);
  MX.active = null; MX.forecastAge = null; MX.forecastKeyFor = null;
  MX.ageVal = String(Math.max(0, Math.min(120, MX.res.age)));
  return true;
}

function mxCalculate(){
  const chk = MatrixCore.validateDate(MX.date);
  if (!chk.ok){ MX.err = chk.error; MX.res = null; render({keepScroll:true, noIntro:true}); const i = document.getElementById('mxDate'); if (i) i.focus(); return; }
  MX.err = '';
  try { localStorage.setItem(MX_KEY, MX.date); } catch (e) {}
  // Оплата привязана к дате: для другой даты платное закрывается снова.
  if (MX.paid && MX.paidDate !== MX.date) mxResetPaid();
  mxCompute(chk);
  MX.active = null; MX.forecastAge = null; MX.forecastKeyFor = null;
  MX.ageVal = String(Math.max(0, Math.min(120, MX.res.age)));
  render({keepScroll:true, noIntro:true});
  const r = document.getElementById('mxResult');
  if (r) r.scrollIntoView({behavior: reduceMotion ? 'auto' : 'smooth', block: 'start'});
}

