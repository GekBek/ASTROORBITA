function mxMarkNodes(){
  const R = MX.res; if (!R) return;
  document.querySelectorAll('.mx-n').forEach(g => g.classList.remove('active', 'now', 'prog'));
  if (MX.active){ const a = document.querySelector('.mx-n[data-pos="' + MX.active + '"]'); if (a) a.classList.add('active'); }
  document.querySelectorAll('.chip-pos').forEach(c => c.classList.toggle('active', !!MX.active && c.dataset.pos === MX.active));
  const nowKey = MatrixCore.getAgeNodeKey(R.age);
  const n = document.querySelector('.mx-n[data-pos="' + nowKey + '"]'); if (n) n.classList.add('now');
  R.programs.forEach(p => p.positions.split('-').forEach(pos => {
    const g = document.querySelector('.mx-n[data-pos="' + pos + '"]'); if (g) g.classList.add('prog');
  }));
}

function mxRenderReading(){
  const el = document.getElementById('mxReading'); if (!el) return;
  if (!MX.active){
    el.innerHTML = '<div class="rd-intro">' + ic('matrix') + '<h3>Трактовки позиций</h3><p>Нажмите на число на схеме или выберите позицию в списке — здесь появится трактовка.' + (MX.paid ? '' : ' Личный квадрат (A–E) открыт бесплатно.') + '</p></div>';
  } else {
    el.innerHTML = mxReadingHTML(MX.active);
  }
  const b = el.closest('.mx-b'); if (b) b.scrollTop = 0;
